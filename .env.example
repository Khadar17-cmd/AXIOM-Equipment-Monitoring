# Optional SMTP settings for sending real email alerts.
# Configure these as environment variables before starting Flask.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-email@gmail.com

# Change this before deploying beyond a local college demonstration.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
